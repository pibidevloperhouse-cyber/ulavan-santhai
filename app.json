{
  "expo": {
    "name": "Ulavan Santhai",
    "slug": "ulavan-santhai-mobile",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#174B35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ulavansanthai.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#174B35"
      },
      "package": "com.ulavansanthai.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
